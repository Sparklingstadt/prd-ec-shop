{
  "name": "prd-ec-shop",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "npm run db:start && next dev",
    "build": "prisma generate && next build",
    "db:start": "docker compose up -d --wait db",
    "db:stop": "docker compose down",
    "db:logs": "docker compose logs -f db",
    "db:setup": "npm run db:start && npm run db:migrate && npm run db:seed",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "start": "next start",
    "lint": "eslint",
    "test": "tsx --test services/checkout/orderPricing.test.mts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "next": "^16.3.0",
    "next-auth": "^5.0.0-beta.32",
    "pg": "^8.22.0",
    "react": "19.2.3",
    "react-dom": "19.2.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.18.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^16.3.0",
    "prisma": "^7.9.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.11",
    "typescript": "^5"
  }
}
